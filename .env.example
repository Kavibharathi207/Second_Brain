# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ChromaDB Configuration
CHROMA_DB_PATH=./data/chroma
CHROMA_COLLECTION_NAME=memories

# SQLite
SQLITE_PATH=./data/second_brain.db

# Security Configuration  (CHANGE THESE — never commit real values)
ENCRYPTION_KEY=your-secure-encryption-key-here
SECRET_CODE=change-this-before-running
SALT_FILE=./data/salt.bin
PBKDF2_ITERATIONS=390000

# RAG Configuration
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.3
RAG_SEMANTIC_WEIGHT=0.7
RAG_PRIORITY_WEIGHT=0.3

# Memory Decay
MEMORY_DECAY_ENABLED=True
HALF_LIFE_HOURS=168
DECAY_FACTOR=0.95

# Reminder Lifecycle
DEFAULT_GRACE_PERIOD_HOURS=24
DEFAULT_ARCHIVE_AFTER_HOURS=72

# Scheduler
DECAY_JOB_INTERVAL_MINUTES=60
REMINDER_SWEEP_INTERVAL_MINUTES=5

# Application
APP_HOST=localhost
APP_PORT=8501
DEBUG=False
